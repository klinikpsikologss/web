# Yönetim paneli (/panel). Boş bırakılırsa varsayılanlar kullanılır; yayına almadan önce değiştirin.
PANEL_SECRET=uzun-rastgele-bir-metin
# PANEL_USERNAME=admin
# PANEL_PASSWORD=klinikpsikoloogselinsak.
# Kalıcı veri klasörü (varsayılan: ./data). Sunucuda kalıcı bir diske işaret etmeli.
# DATA_DIR=/var/data/selinsak
# Sunucusuz barındırmada (Vercel) dosya yerine Upstash Redis:
# (KV_REST_API_URL / KV_REST_API_TOKEN adları da kabul edilir. Standart Redis için: KV_REDIS_URL veya REDIS_URL)
# KV_REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# İletişim formu e-posta bildirimi (isteğe bağlı)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=psikologselinsak@gmail.com
# CONTACT_FROM_EMAIL=Klinik Psikolog Selin Sak <bildirim@klinikpsikologselinsak.com>
# Görsel yüklemeleri için Cloudinary (ücretsiz plan yeterli). Üçü de doluysa görseller buluta yüklenir.
# CLOUDINARY_CLOUD_NAME=kfxxpttf
# CLOUDINARY_API_KEY=895621166392675
# CLOUDINARY_API_SECRET=GwMRYOcA3VmcE02TiKDIxVy9F_U
